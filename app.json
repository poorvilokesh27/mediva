{
  "expo": {
    "name": "MediPal",
    "slug": "medipal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E88E5"
    },
    "android": {
      "package": "com.medipal.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E88E5"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E88E5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bc5dff18-e110-4869-9863-85b04b2fc644"
      }
    },
    "owner": "poorvilokesh"
  }
}
